{
  "name": "@rahhal/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate:up": "tsx src/postgres/migrate-cli.ts up",
    "db:migrate:down": "tsx src/postgres/migrate-cli.ts down",
    "db:setup:local-compose": "tsx src/postgres/local-setup-cli.ts",
    "db:seed": "tsx src/postgres/seed-cli.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test:postgres": "node --env-file-if-exists=../../.env ../../node_modules/.bin/vitest run test/postgres-*.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'test/postgres-*.test.ts'"
  },
  "dependencies": {
    "@rahhal/contracts": "0.1.0",
    "@rahhal/domain": "0.1.0",
    "fastify": "5.11.3",
    "openid-client": "6.8.7",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@rahhal/testkit": "0.1.0",
    "@types/node": "22.18.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.12",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}

{
  "name": "rahhal-open-innovation-frontend",
  "version": "2.9.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "npm run build:packages && next dev --webpack",
    "dev:web": "npm run build:packages && next dev --webpack",
    "dev:web:network": "npm run build:packages && RAHHAL_WEB_RUNTIME=network next dev --webpack",
    "dev:api": "npm run build:packages && npm run dev --workspace @rahhal/api",
    "dev:worker": "npm run build:packages && npm run dev --workspace @rahhal/worker",
    "docker:config": "docker compose config --quiet",
    "docker:env:init": "node scripts/create-local-env.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --detach --wait",
    "docker:smoke": "node scripts/smoke-docker.mjs",
    "docker:logs": "docker compose logs --follow",
    "docker:down": "docker compose down --remove-orphans",
    "db:up": "docker compose up postgres --detach --wait",
    "db:down": "docker compose stop postgres",
    "db:migrate:up": "npm run db:migrate:up --workspace @rahhal/api",
    "db:migrate:down": "npm run db:migrate:down --workspace @rahhal/api",
    "db:reset": "npm run db:reset --workspace @rahhal/api",
    "db:seed": "npm run db:seed --workspace @rahhal/api",
    "build": "npm run build:packages && npm run build:web:app && npm run build:services",
    "build:web": "npm run build:packages && npm run build:web:app",
    "build:web:network": "npm run build:packages && RAHHAL_WEB_RUNTIME=network next build --webpack",
    "build:web:app": "next build --webpack && node scripts/build-offline-bundle.mjs",
    "build:packages": "npm run build --workspace @rahhal/domain && npm run build --workspace @rahhal/contracts && npm run build --workspace @rahhal/testkit",
    "build:services": "npm run build --workspace @rahhal/api && npm run build --workspace @rahhal/worker",
    "build:workspaces": "npm run build:packages && npm run build:services",
    "build:standalone": "node scripts/build-offline-bundle.mjs",
    "start": "serve out",
    "start:api": "npm run start --workspace @rahhal/api",
    "start:worker": "npm run start --workspace @rahhal/worker",
    "typecheck": "npm run typecheck:web && npm run typecheck:workspaces",
    "typecheck:web": "tsc --noEmit",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run build:packages && vitest run",
    "test:flows": "npm run build:packages && vitest run tests/e2e-navigation.test.tsx tests/flows.test.ts tests/challenge-flow.test.ts",
    "test:challenge": "npm run build:packages && vitest run tests/challenge-flow.test.ts tests/challenge-gateway.test.ts tests/challenge-hooks.test.tsx tests/challenge-opportunity-gateway.test.ts tests/challenge-opportunity-ui.test.tsx",
    "test:organization": "npm run build:packages && vitest run tests/organization-parity-v25.test.tsx",
    "test:contracts": "npm run build:packages && npm run test --workspace @rahhal/contracts",
    "test:api": "npm run build:packages && npm run test --workspace @rahhal/api",
    "test:postgres": "npm run build:packages && npm run build --workspace @rahhal/worker && npm run test:postgres --workspace @rahhal/api",
    "test:worker": "npm run build:packages && npm run test --workspace @rahhal/worker",
    "test:smoke": "node scripts/smoke-static.mjs",
    "test:standalone-interactive": "node scripts/smoke-standalone-interactive.mjs",
    "test:watch": "npm run build:packages && vitest",
    "test:browser": "playwright test playwright/behavior.pw.ts",
    "test:visual": "playwright test playwright/visual.pw.ts",
    "test:visual:update": "playwright test playwright/visual.pw.ts --update-snapshots",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:routes": "node scripts/verify-routes.mjs",
    "verify:links": "node scripts/check-links.mjs",
    "verify:offline": "node scripts/verify-offline-bundle.mjs",
    "verify:boundaries": "node scripts/check-workspace-boundaries.mjs",
    "verify:vocabulary": "node scripts/check-canonical-vocabulary.mjs",
    "verify:generated": "git diff --exit-code -- index.html next-env.d.ts",
    "qa:report": "node scripts/generate-qa-report.mjs",
    "qa:manifest": "node scripts/generate-route-manifest.mjs",
    "qa:size": "node scripts/analyze-standalone.mjs",
    "analyze:source": "node scripts/analyze-source-architecture.mjs",
    "analyze:source:check": "node scripts/analyze-source-architecture.mjs --check",
    "analyze:build": "node scripts/analyze-build-assets.mjs",
    "analyze:bundle": "node scripts/run-bundle-analysis.mjs",
    "check:budgets": "node scripts/check-performance-budgets.mjs --runtime=demo",
    "check:budgets:network": "node scripts/check-performance-budgets.mjs --runtime=network",
    "css:prune-legacy": "node scripts/prune-legacy-shell-css.mjs",
    "test:browser:connected": "PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test playwright/connected.pw.ts --project=desktop-1280x800",
    "test:browser:b7": "PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test playwright/b7.pw.ts --project=desktop-1280x800",
    "test:browser:c1": "PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test playwright/c1.pw.ts --project=desktop-1280x800",
    "seed:demo": "PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test playwright/seed-demo.pw.ts --project=desktop-1280x800 --reporter=list"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "axe-core": "4.12.1",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.1",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.26",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "serve": "14.2.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}

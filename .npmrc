# Phase 0 baseline — deterministic installs (addresses R-10 / T-04)
# Always install platform-specific optional deps (Sharp/libvips) from the lockfile.
# Plain `npm ci` has been observed to omit @img/sharp-libvips-* on macOS arm64;
# keeping optional deps on makes installs reproducible across machines and CI.
# See CONTRIBUTING.md and 82_PHASE0_COMPLETION.md.
include=optional
engine-strict=true
save-exact=true
fund=false
audit=true

{
  "name": "@rahhal/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./openapi": {
      "types": "./src/openapi.ts",
      "import": "./dist/openapi.js",
      "default": "./dist/openapi.js"
    },
    "./openapi.json": "./dist/openapi.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/export-openapi.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@rahhal/domain": "0.1.0"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}

# Rahhal / راه‌حل — environment contract
# Copy to `.env.local` (never commit real secrets). Phase 0 establishes this
# contract; the frontend today needs almost none of it — the backend variables
# are declared now so Phase 1 has a single, reviewed source of truth.
# Authoritative design: project-documents/40_BACKEND_ARCHITECTURE.md.

# ── Current (frontend / build) ────────────────────────────────────────────────
# Public base URL used by link/route verification and canonical metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production builds MUST disable all demo/mock authority (40 §9, R-01/R-02).
# 'demo' = mock stores active; 'production' = mock mutations & QA switchers off.
NEXT_PUBLIC_APP_MODE=demo

# ── Phase 1 backend (NOT used yet — declared for the coming API/worker) ────────
# Runtime
NODE_ENV=development
APP_REGION=ir-tehran                 # data residency (DEC-2026-005)
LOG_LEVEL=info

# PostgreSQL (authoritative store — 50_DATA_MODEL.md)
DATABASE_URL=postgres://user:password@localhost:5432/rahhal
DATABASE_POOL_MAX=10

# Identity — managed OIDC (ADR-0010). App stores only the user↔subject link.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SESSION_JWT_PUBLIC_KEY=
SESSION_REFRESH_TTL_SECONDS=1209600

# Object storage — private, in-region, S3-compatible (ADR-0009)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=rahhal-private
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
MALWARE_SCANNER_URL=

# Queue / outbox relay (ADR-0008) — Postgres-backed at pilot scale
QUEUE_BACKEND=postgres

# Providers (deferred to Slice 2 — leave blank in Phase 1)
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
ESIGNATURE_PROVIDER_API_KEY=
PAYMENT_PROVIDER_API_KEY=

# Observability (NFR-OBS-001)
OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_MONITORING_DSN=

# Security
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120

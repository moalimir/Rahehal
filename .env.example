# Rahhal / راه‌حل — environment contract
# Copy frontend-only values to `.env.local` for native Next.js development.
# Docker Compose requires an uncommitted `.env` for A2's two generated local
# secrets; create it once with `npm run docker:env:init`. The native API/worker scripts
# do not load either root file: pass their demo variables in the shell as shown
# in README, or add a reviewed env-file loader later.
# Blank provider/infrastructure values are the reviewed Phase 1 contract only.
# Authoritative design: project-documents/40_BACKEND_ARCHITECTURE.md.

# ── Current (frontend / build) ────────────────────────────────────────────────
# Reserved Phase-1 web settings; the current static web does not consume them.
# Its checked-in gateway composition is always demo-only, so these values are
# not a production kill switch and must not be treated as one.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_MODE=demo

# ── Local Docker integration stack ──────────────────────────────────────────
# These are host-side Compose substitutions, not container secrets. The stack
# binds every published port to 127.0.0.1.
RAHHAL_WEB_PORT=3000
RAHHAL_API_PORT=3001
RAHHAL_POSTGRES_PORT=5433
# Synthetic local-only credential. Never reuse outside this Compose stack.
RAHHAL_POSTGRES_PASSWORD=rahhal-local-only
RAHHAL_REVISION=local
RAHHAL_API_IMAGE=rahhal/api:local
RAHHAL_OIDC_FLOW_SECRET=
RAHHAL_SESSION_CREDENTIAL_SECRET=

# ── Backend workspaces ────────────────────────────────────────────────────────
# Runtime
NODE_ENV=development
APP_REGION=ir-tehran                 # data residency (DEC-2026-005)
LOG_LEVEL=info

# The checked-in adapters are deterministic development evidence only. Both
# services fail closed in NODE_ENV=production; replace them with reviewed
# infrastructure adapters rather than changing these values in production.
RAHHAL_API_MODE=demo
RAHHAL_API_HOST=127.0.0.1
RAHHAL_WORKER_MODE=demo

# PostgreSQL (authoritative store — 50_DATA_MODEL.md)
DATABASE_URL=postgresql://rahhal:rahhal-local-only@127.0.0.1:5433/rahhal
DATABASE_POOL_MAX=10

# Identity — managed OIDC (ADR-0010). App stores only the user↔subject link.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_REDIRECT_URIS=
OIDC_ALLOW_INSECURE_HTTP=false
OIDC_FLOW_SECRET=
SESSION_CREDENTIAL_SECRET=
SOLVER_CONTACT_VERIFICATION_PROVIDER=development
SOLVER_OTP_DEVELOPMENT_CODE=12345
SOLVER_OTP_FLOW_SECRET=
SESSION_JWT_PUBLIC_KEY=
SESSION_REFRESH_TTL_SECONDS=1209600

# Object storage — private, in-region, S3-compatible (ADR-0009)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=rahhal-private
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
MALWARE_SCANNER_URL=

# Queue / outbox relay (ADR-0008) — Postgres-backed at pilot scale
QUEUE_BACKEND=postgres

# Providers (deferred to Slice 2 — leave blank in Phase 1)
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
ESIGNATURE_PROVIDER_API_KEY=
PAYMENT_PROVIDER_API_KEY=

# Observability (NFR-OBS-001)
OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_MONITORING_DSN=

# Security
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
